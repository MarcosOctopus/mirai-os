# Dependencies
node_modules/

# Build
.next/

# Data
data/*.sqlite
data/*.sqlite-*
# O BANCO VIVO NUNCA ENTRA NO GIT (dono, 13/10/2026).
# Por que a regra existe: `data/auth.db` estava versionado, então um
# `git checkout -- data/auth.db` (limpeza de rotina) REVERTIA o banco inteiro —
# apagando as chaves do GitHub que o dono tinha acabado de gravar pela tela.
# Banco vivo é ESTADO, não código: sai do git e fica só no disco (com backup).
data/auth.db
data/auth.db-*
data/auth.db.*
data/media-factory.sqlite
data/media-factory.sqlite-*

# Media assets (generated)
public/music/
public/thumbs/

# Anexos do chat (conteudo dos usuarios — nunca versionar)
data/uploads/

# Environment
.env
.env.local
.env.production
.env.development

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temp
SESSION_STATE.md
*.backup

# segredos (nunca versionar)
.mirai_key
.credentials/
data/*.db-shm
data/*.db-wal

# copias de seguranca locais
*.bak
*.bak-*
*.backup

# ── NUNCA versionar: backups de .env e cofres locais (têm segredo/dado de gente) ──
.env*.pre-*
.env*.pos-*
data/*.db
data/*.db-*
data/tokens.db
*.tok

# cópias de build antigas (.next-pre-*, .next-bom-*): lixo, nunca versionar
.next-*

# cópias de segurança de arquivo (.pre-*/.pos-*) e bancos locais: o git JÁ é o backup
*.pre-*
*.pos-*
data/*.db*
tsconfig.tsbuildinfo
