# Dependencies
node_modules/

# Build
.next/

# Data
data/*.sqlite
data/*.sqlite-*
# O BANCO VIVO NUNCA ENTRA NO GIT (dono, 13/10/2026).
# Por que a regra existe: `data/auth.db` estava versionado, então um
# `git checkout -- data/auth.db` (limpeza de rotina) REVERTIA o banco inteiro —
# apagando as chaves do GitHub que o dono tinha acabado de gravar pela tela.
# Banco vivo é ESTADO, não código: sai do git e fica só no disco (com backup).
data/auth.db
data/auth.db-*
data/auth.db.*
data/media-factory.sqlite
data/media-factory.sqlite-*

# Media assets (generated)
public/music/
public/thumbs/

# Anexos do chat (conteudo dos usuarios — nunca versionar)
data/uploads/

# ── WORKSPACES DO ARQUITETO: código de TERCEIRO, clonado (dono, 14/10/2026) ──
# O que entra aqui veio de repositório de fora (do dono ou de um cliente). Não é
# código nosso: versionar significaria (a) inchar o repositório com projeto
# alheio, (b) misturar projetos, o que a regra de isolamento proíbe, e (c) deixar
# código de cliente no git. Fica só no disco, com teto de tamanho, por conta.
data/arquiteto-workspaces/

